# Server Configuration
MONGO_URI=mongodb://localhost:27017/ehms
PORT=5001
JWT_SECRET=your_jwt_secret_key

# Firebase Admin SDK Configuration (FCM)
# Option 1: Path to serviceAccountKey.json file (default: ./config/serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# Option 2: Or paste the raw JSON string of serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Option 3: Or configure individual service account fields
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
